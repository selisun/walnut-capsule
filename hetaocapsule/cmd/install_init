#!/bin/bash
# 安装前脚本：飞牛在用户填完安装向导、解压文件之前调用。
# 向导字段值可能只在这一阶段注入（如 wizard_service_port），这里先把端口落盘，
# 供 install_callback 与程序启动时读取；同时记录向导相关环境变量便于排查。

pick_port() {
    for name in wizard_service_port service_port WIZARD_SERVICE_PORT; do
        eval "v=\${$name:-}"
        [ -n "$v" ] && { printf '%s' "$v"; return; }
    done
    # 兜底：任何 wizard_* 形式的变量，取值像端口（1024-65535）就采用。
    while IFS='=' read -r k v; do
        case "$k" in wizard_* | WIZARD_*) : ;; *) continue ;; esac
        case "$v" in '' | *[!0-9]*) continue ;; esac
        if [ "$v" -ge 1024 ] && [ "$v" -le 65535 ]; then
            printf '%s' "$v"
            return
        fi
    done <<EOF
$(env)
EOF
    printf '%s' "${TRIM_SERVICE_PORT:-}"
}

dump_env() {
    [ -n "${TRIM_PKGVAR:-}" ] || return 0
    mkdir -p "${TRIM_PKGVAR}" 2>/dev/null || return 0
    {
        echo "--- $(date '+%F %T') install_init ---"
        env | grep -iE '^(wizard|install_|trim_service_port)' | sort
    } >> "${TRIM_PKGVAR}/wizard-env.log" 2>/dev/null
}

PORT="$(pick_port | tr -d '[:space:]')"
dump_env

case "$PORT" in
'' | *[!0-9]*) exit 0 ;; # 拿不到有效端口时交给 install_callback 兜底
esac
if [ "$PORT" -lt 1024 ] || [ "$PORT" -gt 65535 ]; then
    exit 0
fi

if [ -n "${TRIM_PKGVAR:-}" ]; then
    mkdir -p "${TRIM_PKGVAR}" 2>/dev/null
    printf '%s' "$PORT" > "${TRIM_PKGVAR}/port" 2>/dev/null
fi

exit 0
