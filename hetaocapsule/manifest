appname=hetaocapsule
version=0.1.77
display_name=核桃胶囊
desc=<p>核桃胶囊是一款轻量 NAS 状态监控应用：在电脑桌面以悬浮胶囊实时显示 NAS 的 CPU、内存、网络速率、硬盘读写与存储卷用量。</p><p>应用内置管理页，可查看并复制配对令牌、选择监控网卡、手动设置网卡协商速率、查看运行日志，并直接下载 Windows 电脑客户端。数据仅在局域网内传输，不监听公网、不收集任何用户数据。</p>
platform=x86
source=thirdparty
maintainer=蓝胖纸
maintainer_url=https://github.com/selisun/walnut-capsule
distributor=蓝胖纸
distributor_url=https://blog.mzl.cc
icon_url=https://raw.githubusercontent.com/selisun/walnut-capsule/main/hetaocapsule/ICON_256.PNG
# service_port 仅是名义默认值：实际监听端口由安装向导填写并写入 ${TRIM_PKGVAR}/port，
# 因此不开平台端口占用检查（checkport=false），否则会拿 8765 误判用户自选端口。
service_port=8765
desktop_uidir=ui
desktop_applaunchname=hetaocapsule.Application
checkport=false
# 本应用不使用用户文件/目录授权功能，隐藏设置页里无意义的"授权目录"项
disable_authorization_path=true
# 桌面管理页走飞牛统一网关（/app/hetaocapsule），需 1.1.3100+
# 注意：appname 不能含点（如 com.hetao.capsule），否则 appcenter 不解析 gateway 字段导致桌面图标 404
os_min_version=1.1.3100
ctl_stop=true
changelog=【电脑端】优化：小屏显卡卡位改为「有数据优先、同为有数据时独显优先」，双显卡机器不再只显示核显；读不到的指标继续显示 --。【NAS 端】沿用上版的多卡并列采集与品牌占位能力（NVIDIA 驱动未就绪时仍上报厂商并明确提示状态）。
